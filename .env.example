# Copy to .env if you want to override defaults. No secrets.
PORT=7860
MODEL_PATH=models/yolov8n.onnx
IMGSZ=640
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
MAX_DETECTIONS=300
MAX_BATCH=16
MAX_UPLOAD_MB=10
MAX_VIDEO_SECONDS=10
MAX_VIDEO_FRAMES=300
MAX_QUEUED_JOBS=4
MAX_RETAINED_JOBS=2
JOB_TTL_SECONDS=1800
# 0 lets ONNX Runtime pick. render.yaml pins this to 1 on the free instance.
ORT_THREADS=0
